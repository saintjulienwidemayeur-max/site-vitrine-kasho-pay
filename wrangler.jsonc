// Cloudflare Workers settings for the Kasho Pay showcase site (static files + the redirect in worker.js).
// Deploy: connect the repository in Cloudflare (Workers & Pages), build command empty, deploy command `npx wrangler deploy`.
// Then add the custom domains kashopay.com and www.kashopay.com to this Worker (Settings > Domains & Routes).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kasho-pay-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
